#!/bin/sh
# git bclone <repo> [<name>]
# Clone <repo> into a bare+worktree layout: <name>/.bare holds the repository
# and the default branch is checked out at <name>/<default-branch>.
set -u

repo="${1:-}"
name="${2:-}"
[ -n "$repo" ] || {
    echo 'usage: git bclone <repo> [<name>]' >&2
    exit 2
}

if [ -z "$name" ]; then
    name=${repo##*/}  # strip any path
    name=${name##*:}  # strip scp-style host:
    name=${name%.git} # strip .git suffix
fi
[ -n "$name" ] || {
    echo 'Could not determine repo name' >&2
    exit 1
}
[ -e "$name" ] && {
    echo "Destination '$name' already exists" >&2
    exit 1
}

mkdir -p "$name"
git clone --bare "$repo" "$name/.bare"
git --git-dir="$name/.bare" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
git --git-dir="$name/.bare" fetch origin
def=$(git --git-dir="$name/.bare" symbolic-ref --quiet --short HEAD || echo main)
git --git-dir="$name/.bare" worktree add "$name/$def" "$def"
git -C "$name/$def" config branch."$def".remote origin
git -C "$name/$def" config branch."$def".merge "refs/heads/$def"
